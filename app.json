{
  "expo": {
    "name": "Daily Journal",
    "slug": "daily-journal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.dailyjournal",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock your private journal with Face ID.",
        "NSPhotoLibraryUsageDescription": "Add photos from your library to journal entries."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF6EF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yourname.dailyjournal"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock your private journal with Face ID."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Add photos from your library to journal entries.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "dailyjournal"
  }
}